promptster
promptster-cli
# Anchored, NOT `bin/`: an unanchored pattern also matched npm/bin/, which is
# how the npm package's `bin` shim went missing from the published tarball
# for every release up to v1.7.0 without anyone getting a warning.
/bin/
/dist/
npm/binaries/
node_modules/
.DS_Store
# Contents, not the directory: `.claude/` wholesale also hid `.claude/skills/`,
# which is where the verify-cli symlink lives. Worktrees and local settings stay
# ignored; a re-include cannot work if the parent directory itself is excluded.
.claude/*
!.claude/skills/
